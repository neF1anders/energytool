%% Путь клиента: сайт → чат → анкета → бриф менеджеру. Подробно: user-journey.mockup.html
flowchart LR
  classDef user fill:#fde8e9,stroke:#e30613,color:#1b1f27
  classDef bot fill:#e9effc,stroke:#2a5bd7,color:#1b1f27
  classDef mgr fill:#e3f4ea,stroke:#1f8a4c,color:#1b1f27

  s1["Сайт: «Заказать консультацию»<br/>открывается чат"]:::user --> b1["Бот: «Что хотите решить?»<br/>+ 4 кнопки-сценария"]:::bot
  b1 --> s2["Клиент: боль своими словами"]:::user --> b2["Бот: ответ по базе + 1 вопрос"]:::bot
  b2 --> loop{"READY?"}:::bot
  loop -- нет --> s3["Клиент отвечает или спрашивает сам"]:::user --> b3["Бот: ответ (если был вопрос)<br/>+ вопрос по next_slot"]:::bot --> loop
  loop -- да --> b4["Бот: показывает собранное,<br/>предлагает оставить контакт"]:::bot
  b4 -- согласен --> s4["ФИО, телефон, компания, согласие"]:::user --> m1["Менеджер: бриф сразу с заявкой"]:::mgr --> m2["Звонок с расчётом"]:::mgr
  b4 -- отказ --> b5["Бот: «что подготовить к звонку»,<br/>продолжает отвечать"]:::bot
