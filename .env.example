# Профиль моделей: platform | openrouter
MODELS_PROFILE=openrouter

# --- генеративная модель (платформа передаёт сама; синонимы: BASE_URL, OPENAI_BASE_URL) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- эмбеддер и реранкер (по умолчанию — как у LLM) ---
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# --- параметры платформы ---
DATA_DIR=data
TEMPERATURE=
MAX_TOKENS=
MAX_WORKERS=
TOP_K=
RERANKER_TOP_N=

# --- свои ---
LOG_LEVEL=INFO
LOG_FORMAT=json
RUN_BUDGET_SEC=1080
