# Локально: cp .env.example .env и заполнить. Запуск: `uv run --env-file .env ...`
# или `docker compose up --build` (compose читает .env сам). Ключей в репозитории нет.

# Профиль моделей: platform | openrouter
MODELS_PROFILE=openrouter

# --- генеративная модель (синонимы: BASE_URL/OPENAI_BASE_URL, OPENAI_API_KEY, GEN_MODEL/OPENAI_MODEL)
# openrouter: LLM_BASE_URL по умолчанию https://openrouter.ai/api/v1; LLM_MODEL обязателен.
# Проверено: qwen/qwen3.8-27b (та же модель, что на платформе).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# выключить thinking Qwen (параметры калибруются на старте: reasoning / chat_template_kwargs)
LLM_DISABLE_THINKING=true
LLM_MAX_RETRIES=3

# --- эмбеддер и реранкер: пустые адрес и ключ = как у LLM (на OpenRouter есть обе модели)
# EMB_API_KEY (синоним платформы: EMBEDDER_API_KEY)
EMB_PROVIDER=remote
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=baai/bge-m3
RERANKER_PROVIDER=remote
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=qwen/qwen3-reranker-8b

# --- параметры платформы (этап 1); пусто — значения по умолчанию
DATA_DIR=data
TEMPERATURE=
MAX_TOKENS=
MAX_WORKERS=4
TOP_K=4
RERANKER_TOP_N=

# --- этап 1: конвейер и бюджет времени
# naive | full (full = Extractor + анкета; на демо качество равное, naive вдвое быстрее)
BATCH_PIPELINE=naive
BATCH_ASK=false
FAST_PATH_SEC=900
RUN_BUDGET_SEC=1080

# этап 1, ответ: разделов после реранкера, отсечение слабых (доля от лучшего скора и пол),
# скор, ниже которого «в базе нет ответа», бюджет токенов найденных разделов
ANSWER_TOP_K=8
ANSWER_KEEP_RATIO=0.4
ANSWER_KEEP_FLOOR=0.25
ANSWER_MIN_SCORE=0.15
ANSWER_CONTEXT_TOKENS=5000
# разделы-ограничения базы и подсказки для уточняющего вопроса в промпте
BATCH_GUARDRAILS=true
# вопрос для поиска из истории диалога (ещё один вызов LLM на диалог)
BATCH_CONDENSE=false
# диалог: сколько разделов добавить по предыдущим репликам клиента (0 — выключено)
DIALOG_TOPIC_K=0
# соседи найденных разделов в промпте: none | siblings | file, и их бюджет токенов
ANSWER_EXPAND=none
ANSWER_EXPAND_TOKENS=3000
# порядок блоков промпта: facts_first | rules_first; порядок фрагментов: best_first | best_last
ANSWER_LAYOUT=facts_first
ANSWER_EVIDENCE_ORDER=best_first
# образцы ответов организаторов в промпте (только разработка; в ZIP — build_submission
# --style-examples): каталог с demo_questions.csv и demo_output.csv; block | turns;
# HOLDOUT=true на eval прячет образец с тем же вопросом
STYLE_EXAMPLES_DIR=
STYLE_EXAMPLES_MODE=block
STYLE_SHOTS_K=3
STYLE_EXAMPLES_HOLDOUT=false

# --- поиск: hybrid_rerank | hybrid | bm25_rerank | bm25 | dense_rerank | dense
RETRIEVAL_CONFIG=hybrid_rerank

# --- веб
SQLITE_PATH=var/energytool.sqlite
# пусто — заявки пишутся в таблицу leads со статусом mock_sent
CRM_WEBHOOK_URL=
APP_PORT=8000

# --- логи: json | text
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- только разработка: дисковый кэш эмбеддингов (каталог в .gitignore)
EMB_CACHE_DIR=.cache/embeddings
# дисковый кэш ответов моделей: повторный прогон eval не тратит бюджет ключа
LLM_CACHE_DIR=.cache/llm
