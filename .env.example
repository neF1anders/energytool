# Локально: cp .env.example .env, заполнить, запускать через `uv run --env-file .env ...`
# Профиль моделей: platform | openrouter
MODELS_PROFILE=openrouter

# --- генеративная модель (синонимы: BASE_URL/OPENAI_BASE_URL, OPENAI_API_KEY, GEN_MODEL/OPENAI_MODEL)
# openrouter: LLM_BASE_URL по умолчанию https://openrouter.ai/api/v1, LLM_MODEL обязателен
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- эмбеддер и реранкер: пустые адрес и ключ = как у LLM
# EMB_API_KEY (синоним платформы: EMBEDDER_API_KEY)
EMB_PROVIDER=remote
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=
RERANKER_PROVIDER=remote
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# --- параметры платформы
DATA_DIR=data
TEMPERATURE=
MAX_TOKENS=
MAX_WORKERS=
TOP_K=
RERANKER_TOP_N=

# --- свои
LLM_MAX_RETRIES=3
# выключить thinking Qwen (openrouter: reasoning.enabled=false; platform: chat_template_kwargs)
LLM_DISABLE_THINKING=true
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
RUN_BUDGET_SEC=1080
